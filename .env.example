# Copiá este archivo a .env y completá los valores.
# docker compose lo lee automáticamente si está al lado del compose.

# Puerto en el que escucha la app dentro del contenedor.
PORT=8087
# Puerto en la máquina anfitriona (lo que abrís en el browser).
HOST_PORT=8087

# Clave del cuarto oscuro. CAMBIALA.
ADMIN_PASSWORD=cambiame

# Firma de la cookie de sesión. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiame-tambien

# Dónde viven originales, previews, zips y la base.
#
# NO lo definas acá si usás Docker: el compose ya lo fija en /data (el volumen),
# y un valor relativo en este archivo puede terminar dentro del contenedor y
# hacer que las subidas fallen con ENOENT sobre 'data/originals/...'.
# Sin contenedor, el default del código ya es la carpeta ./data del proyecto.
# DATA_DIR=./data

# Opcional: URL que recibe el aviso cuando alguien pide reabrir un rollo
# (ntfy, Gotify, un bot de Telegram, Slack). Sin esto sólo queda en el log.
NOTIFY_WEBHOOK=

# Base para armar el link del aviso.
PUBLIC_URL=http://rollito.local
